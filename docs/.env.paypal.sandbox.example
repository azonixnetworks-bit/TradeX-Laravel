# =========================================================
# TRADEX PAYPAL - SRMKLIVE PLUGIN DRIVER / SANDBOX
# =========================================================

TRADEX_PAYPAL_DRIVER=srmklive
TRADEX_PAYPAL_ENABLED=true
TRADEX_PAYPAL_COUNTRIES=LK,IN
TRADEX_PAYPAL_ENVIRONMENT=sandbox
TRADEX_PAYPAL_WEBHOOK_ID=
TRADEX_PAYPAL_RETURN_URL=
TRADEX_PAYPAL_CANCEL_URL=
TRADEX_EDUCATION_PRICE_USD_MINOR=7900

PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_PAYMENT_ACTION=Sale
PAYPAL_CURRENCY=USD
PAYPAL_NOTIFY_URL=
PAYPAL_LOCALE=en_US
PAYPAL_VALIDATE_SSL=true
PAYPAL_TIMEOUT=30
PAYPAL_CONNECT_TIMEOUT=10
PAYPAL_MAX_RETRIES=2

# Optional legacy/raw HTTP credentials. Leave blank while using srmklive.
TRADEX_PAYPAL_CLIENT_ID=
TRADEX_PAYPAL_CLIENT_SECRET=
TRADEX_PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com
TRADEX_PAYPAL_LIVE_BASE_URL=https://api-m.paypal.com
