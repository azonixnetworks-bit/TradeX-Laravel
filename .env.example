APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# TradeX ADMIN-03A — Video Upload + HLS
# -----------------------------------------------------------------------------
TRADEX_VIDEO_QUEUE=video-processing
TRADEX_VIDEO_MAX_UPLOAD_KB=4194304
TRADEX_VIDEO_PROCESSING_TIMEOUT_SECONDS=7200
TRADEX_VIDEO_WORK_DIR=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
TRADEX_VIDEO_FFMPEG_PRESET=veryfast
TRADEX_VIDEO_FFMPEG_CRF=21
TRADEX_VIDEO_HLS_SEGMENT_SECONDS=6

# -----------------------------------------------------------------------------
# TradeX ADMIN-09 — Finance Daily Owner Report
# -----------------------------------------------------------------------------
TRADEX_FINANCE_TIMEZONE=Asia/Colombo
TRADEX_FINANCE_DAILY_REPORT_ENABLED=false
TRADEX_FINANCE_OWNER_REPORT_EMAIL=
TRADEX_FINANCE_DAILY_REPORT_TIME=00:10

# -----------------------------------------------------------------------------
# TradeX ADMIN-17 — Legal Policy Administration
# -----------------------------------------------------------------------------
# datetime-local values entered by admins are interpreted in this business
# timezone and normalized to the application's UTC clock before persistence.
TRADEX_ADMIN_TIMEZONE=Asia/Colombo

# -----------------------------------------------------------------------------
# TradeX ADMIN-20 / 20C — Customer Onboarding + MFA Recovery
# -----------------------------------------------------------------------------
# Admin-created invitation records expire automatically. Admins never set or
# receive customer passwords, OTP values, TOTP secrets, or MFA recovery codes.
TRADEX_CUSTOMER_INVITATION_DAYS=7
TRADEX_CUSTOMER_RECENT_DAYS=30

# Local/dev may fall back to APP_KEY. Production should set a separate stable,
# high-entropy secret. Changing it invalidates all existing recovery-code hashes.
TRADEX_MFA_RECOVERY_PEPPER=

# -----------------------------------------------------------------------------
# TradeX Registration — WhatsApp OTP via Meta Cloud API
# -----------------------------------------------------------------------------
# Local/testing may keep the log driver. Production must use "meta"; the
# application already forbids OTP log delivery when APP_ENV=production.
TRADEX_REG_WHATSAPP_DRIVER=log

# Keep real Meta credentials only in the deployment environment / secret store.
# Never commit or paste production tokens into source control or test fixtures.
META_WHATSAPP_GRAPH_VERSION=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_OTP_TEMPLATE_NAME=
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_TIMEOUT_SECONDS=10
META_WHATSAPP_CONNECT_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# TradeX ADMIN-22 — Copy Trading Broker Onboarding
# -----------------------------------------------------------------------------
# Optional in local/dev because config can fall back to APP_KEY.
# Production should use a separate high-entropy secret and keep it stable.
# Changing this value changes deterministic duplicate fingerprints.
TRADEX_COPY_TRADE_FINGERPRINT_KEY=
TRADEX_COPY_TRADE_REQUIRED_CURRENCY=USD

# -----------------------------------------------------------------------------
# TradeX API-21 — Stripe Transaction Runtime
# -----------------------------------------------------------------------------
TRADEX_STRIPE_ENABLED=false
# Use * for all customer countries, or comma-separated ISO 2-letter codes.
TRADEX_STRIPE_COUNTRIES=
TRADEX_STRIPE_ENVIRONMENT=SANDBOX
TRADEX_STRIPE_PUBLISHABLE_KEY=
TRADEX_STRIPE_SECRET_KEY=
TRADEX_STRIPE_WEBHOOK_SECRET=
TRADEX_STRIPE_BASE_URL=https://api.stripe.com
TRADEX_STRIPE_SUCCESS_URL=
TRADEX_STRIPE_CANCEL_URL=
TRADEX_STRIPE_TIMEOUT_SECONDS=15
TRADEX_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# TradeX API-21 — NOWPayments Transaction Runtime
# -----------------------------------------------------------------------------
TRADEX_NOWPAYMENTS_ENABLED=false
TRADEX_NOWPAYMENTS_COUNTRIES=
TRADEX_NOWPAYMENTS_ENVIRONMENT=SANDBOX
TRADEX_NOWPAYMENTS_API_KEY=
TRADEX_NOWPAYMENTS_IPN_SECRET=
TRADEX_NOWPAYMENTS_SANDBOX_BASE_URL=
TRADEX_NOWPAYMENTS_LIVE_BASE_URL=https://api.nowpayments.io
TRADEX_NOWPAYMENTS_SUCCESS_URL=
TRADEX_NOWPAYMENTS_CANCEL_URL=
TRADEX_NOWPAYMENTS_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# TradeX API-23 — Mobile API Final Hardening
# -----------------------------------------------------------------------------
TRADEX_API_ALLOWED_HOSTS=
TRADEX_API_REQUIRE_HTTPS=false
TRADEX_API_HSTS_ENABLED=false
TRADEX_API_HSTS_MAX_AGE_SECONDS=31536000
TRADEX_API_HSTS_INCLUDE_SUBDOMAINS=true

VITE_APP_NAME="${APP_NAME}"

# TradeX Copy Trading Billing — ADMIN-24
# Production values must be explicitly approved; do not guess.
TRADEX_COPY_TRADE_FOREX_SERVER_TIMEZONE=
TRADEX_COPY_TRADE_GRACE_PERIOD_DAYS=
TRADEX_COPY_TRADE_BILLING_SWEEP_ENABLED=false
# -----------------------------------------------------------------------------
# TradeX PayPal Transaction Runtime
# -----------------------------------------------------------------------------
TRADEX_PAYPAL_DRIVER=http
TRADEX_PAYPAL_ENABLED=false
# Use * for all customer countries, or comma-separated ISO 2-letter codes.
TRADEX_PAYPAL_COUNTRIES=LK,IN
TRADEX_PAYPAL_ENVIRONMENT=SANDBOX
TRADEX_PAYPAL_CLIENT_ID=
TRADEX_PAYPAL_CLIENT_SECRET=
TRADEX_PAYPAL_WEBHOOK_ID=
TRADEX_PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com
TRADEX_PAYPAL_LIVE_BASE_URL=https://api-m.paypal.com
TRADEX_PAYPAL_RETURN_URL=
TRADEX_PAYPAL_CANCEL_URL=
TRADEX_PAYPAL_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# TradeX Notification Event Automation
# -----------------------------------------------------------------------------
# Keep disabled until migrations + scheduler + queue worker + push provider are
# deployed. Then enable this switch to activate automatic business-event alerts.
TRADEX_NOTIFICATION_AUTOMATION_ENABLED=false
TRADEX_NOTIFICATION_AUTOMATION_IMMEDIATE=true
TRADEX_NOTIFICATION_AUTOMATION_PUSH_IMMEDIATE=true
TRADEX_NOTIFICATION_AUTOMATION_SWEEP_BATCH=100
TRADEX_NOTIFICATION_AUTOMATION_MAX_ATTEMPTS=5
TRADEX_NOTIFICATION_AUTOMATION_RECIPIENT_CHUNK=1000
TRADEX_NOTIFICATION_AUTOMATION_MAX_RECIPIENTS=250000
TRADEX_NOTIFICATION_EVENT_TRADE_IDEAS=true
TRADEX_NOTIFICATION_EVENT_REFERRALS=true
TRADEX_NOTIFICATION_EVENT_MARKET_SESSIONS=true
TRADEX_NOTIFICATION_MARKET_TRIGGER_WINDOW_MINUTES=5
TRADEX_NOTIFICATION_ASIA_SESSION_ENABLED=true
TRADEX_NOTIFICATION_LONDON_SESSION_ENABLED=true
TRADEX_NOTIFICATION_NEW_YORK_AM_ENABLED=true
# New York PM is a TradeX-specific session boundary, not an official exchange
# concept. Do not guess it: set the approved America/New_York local HH:MM first.
TRADEX_NOTIFICATION_NEW_YORK_PM_ENABLED=false
TRADEX_NOTIFICATION_NEW_YORK_PM_TIME=

# Existing API-20 push delivery. Keep provider credentials in deployment secrets.
TRADEX_PUSH_ENABLED=false

# -----------------------------------------------------------------------------
# TradeX SCREENER-01 — Multi-Screener Core + Forex / Twelve Data
# -----------------------------------------------------------------------------
# Keep the real Twelve Data API key only in deployment secrets.
TRADEX_SCREENER_ENABLED=true
TRADEX_TWELVE_DATA_ENABLED=true
TRADEX_TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TRADEX_TWELVE_DATA_API_KEY=
TRADEX_TWELVE_DATA_TIMEOUT_SECONDS=10
TRADEX_TWELVE_DATA_CONNECT_TIMEOUT_SECONDS=5
TRADEX_TWELVE_DATA_BATCH_SIZE=10
TRADEX_TWELVE_DATA_OUTPUT_SIZE=260
TRADEX_SCREENER_CACHE_SECONDS=60
TRADEX_SCREENER_STALE_SECONDS=900
TRADEX_SCREENER_READ_PER_MINUTE=60

# -----------------------------------------------------------------------------
# TradeX SCREENER-02 — Crypto / Binance public Spot market data
# -----------------------------------------------------------------------------
# This adapter uses Binance public market-data-only REST endpoints and does not
# require or accept trading credentials/API secrets.
TRADEX_BINANCE_MARKET_DATA_ENABLED=true
TRADEX_BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
TRADEX_BINANCE_MARKET_DATA_TIMEOUT_SECONDS=10
TRADEX_BINANCE_MARKET_DATA_CONNECT_TIMEOUT_SECONDS=5
TRADEX_BINANCE_MARKET_DATA_OUTPUT_SIZE=260

# -----------------------------------------------------------------------------
# TradeX SCREENER-03 — Deriv public synthetic-index market data
# -----------------------------------------------------------------------------
# Deriv's public market-data WebSocket does not require account credentials.
# Keep this endpoint pinned to the approved Deriv host configured in code.
TRADEX_DERIV_MARKET_DATA_ENABLED=true
TRADEX_DERIV_MARKET_DATA_WEBSOCKET_URL=wss://api.derivws.com/trading/v1/options/ws/public
TRADEX_DERIV_MARKET_DATA_TIMEOUT_SECONDS=10
TRADEX_DERIV_MARKET_DATA_CONNECT_TIMEOUT_SECONDS=5
TRADEX_DERIV_MARKET_DATA_OUTPUT_SIZE=260

# -----------------------------------------------------------------------------
# TradeX SCREENER-04 — Stocks / regional market-data policy
# -----------------------------------------------------------------------------
# Twelve Data's API key is shared with SCREENER-01. Customer-facing stock data
# must not be enabled until the applicable commercial display/redistribution
# rights are approved for TradeX. Sri Lanka CSE remains disabled until an
# approved/licensed CSE data source is connected; do not scrape CSE pages.
TRADEX_STOCKS_SCREENER_ENABLED=true
TRADEX_STOCKS_TWELVE_DATA_ENABLED=true
TRADEX_STOCKS_EXTERNAL_DISPLAY_APPROVED=false
TRADEX_STOCKS_TWELVE_DATA_TIMEOUT_SECONDS=10
TRADEX_STOCKS_TWELVE_DATA_CONNECT_TIMEOUT_SECONDS=5
TRADEX_STOCKS_TWELVE_DATA_OUTPUT_SIZE=260

# -----------------------------------------------------------------------------
# TradeX Forex Screener — IC Markets / cTrader Open API
# -----------------------------------------------------------------------------
# Register and obtain approval for a cTrader Open API application first. Use a
# VIEW-authorised cTID account. Do not commit or paste the real credentials.
# Demo is the safe default; live and demo endpoints are isolated by cTrader.
TRADEX_CTRADER_SCREENER_ENABLED=false
TRADEX_CTRADER_ENVIRONMENT=DEMO
TRADEX_CTRADER_CLIENT_ID=
TRADEX_CTRADER_CLIENT_SECRET=
TRADEX_CTRADER_ACCESS_TOKEN=
# Open API ctidTraderAccountId, NOT the human-facing broker login number.
TRADEX_CTRADER_CTID_TRADER_ACCOUNT_ID=
TRADEX_CTRADER_DEMO_WEBSOCKET_URL=wss://demo.ctraderapi.com:5036/
TRADEX_CTRADER_LIVE_WEBSOCKET_URL=wss://live.ctraderapi.com:5036/
TRADEX_CTRADER_TIMEOUT_SECONDS=12
TRADEX_CTRADER_CONNECT_TIMEOUT_SECONDS=6
TRADEX_CTRADER_OUTPUT_SIZE=260
TRADEX_CTRADER_HISTORICAL_REQUEST_SPACING_MS=225
TRADEX_CTRADER_SYMBOL_MAP_CACHE_SECONDS=21600
TRADEX_CTRADER_FALLBACK_TWELVE_DATA=true
# Optional broker-specific symbol mapping JSON, e.g. {"EUR/USD":"EURUSD"}
TRADEX_CTRADER_SYMBOL_OVERRIDES_JSON={}
